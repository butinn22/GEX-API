# ─────────────────────────────────────────────────────────────────────────────
# GEX-API — environment template
#
#   cp .env.example .env        # then fill in real values
#
# Every value below is read by `trading/config.py`. The defaults shown in the
# comments are the DEV defaults baked into the code — they are fine for local
# use and must be replaced in production (see ARCHITECTURE.md §deployment).
#
# `.env` is git-ignored; this template is not.
# ─────────────────────────────────────────────────────────────────────────────


# ── Storage ──────────────────────────────────────────────────────────────────
# Async SQLAlchemy DSN. SQLite is the dev/test default; production uses
# PostgreSQL + TimescaleDB (see docker-compose.yml).
#   sqlite : sqlite+aiosqlite:///./trading.db
#   postgres: postgresql+asyncpg://user:pass@localhost:5432/gex
TRADING_DATABASE_URL=sqlite+aiosqlite:///./trading.db


# ── Security ─────────────────────────────────────────────────────────────────
# Signs JWTs *and* derives the Fernet key that encrypts stored exchange API
# keys. Changing this invalidates existing tokens and stored keys.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
TRADING_SECRET_KEY=dev-secret-change-me

# Bootstrap admin account for the web console (HTTP Basic / OAuth2 password).
TRADING_ADMIN_USERNAME=admin
TRADING_ADMIN_PASSWORD=admin

# Access-token lifetime in minutes.
TRADING_TOKEN_TTL_MIN=480


# ── Queue / Celery ───────────────────────────────────────────────────────────
# Redis broker (Celery) + result backend. Also used for the run-cancellation
# registry and the token-bucket rate limiter.
TRADING_REDIS_URL=redis://localhost:6379/0
TRADING_REDIS_RESULT_BACKEND=redis://localhost:6379/1

# Hard time limits (seconds) for long-running Celery tasks.
TRADING_BACKTEST_TIME_LIMIT=900
TRADING_MC_TIME_LIMIT=1200


# ── Brokers ──────────────────────────────────────────────────────────────────
# BingX: the REST base URL (region-dependent). API key + secret are NOT set
# here — they are entered in the console and stored encrypted in the database.
BINGX_BASE_URL=https://open-api.bingx.com

# TBANK (T-Investments): read-only token from the broker's cabinet.
# Leave blank to run the adapter in dry-run mode.
TBANK_TOKEN=
TBANK_SANDBOX=true


# ── API / backtest tuning ────────────────────────────────────────────────────
# Per-IP request budget for the REST API (requests per minute).
TRADING_RATE_LIMIT_REQUESTS=300

# Bars per year used to annualise metrics (252 = daily trading days,
# 365 for crypto).
TRADING_PERIODS_PER_YEAR=252

# Seconds a loaded OHLCV window stays cached. Re-running a backtest with one
# parameter changed should not re-download data. 0 disables the cache;
# `"refresh_data": true` on a request bypasses it for that call.
TRADING_DATA_CACHE_TTL=300
